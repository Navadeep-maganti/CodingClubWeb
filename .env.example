# =============================================================
# Coding Club Web - Environment Configuration (Supabase)
# =============================================================
# Copy this file to .env and fill in real values.
# For local dev WITHOUT Supabase, see the "Local Sandbox Fallback" section below.
# =============================================================

# ---------- DATABASE (Supabase PostgreSQL) ----------
# Transaction pooler — used by the Prisma Client at runtime (serverless-safe)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler — used by Prisma Migrate (direct connection, no pooler)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- NEXTAUTH ----------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate_a_base64_secret_here"

# ---------- GOOGLE OAUTH ----------
# In Google Cloud Console, add authorised redirect URIs:
#   - http://localhost:3000/api/auth/callback/google  (dev)
#   - https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ---------- RBAC BOOTSTRAP ----------
# This roll number receives SUPER_ADMIN on first sign-in.
# (coding@nitandhra.ac.in is hardcoded as a bootstrap super-admin — see src/lib/auth.ts)
INITIAL_SUPER_ADMIN_ROLL_NUMBER="424161"

# ---------- SUPABASE STORAGE ----------
# Create a bucket in Supabase Dashboard → Storage (e.g. "club-assets").
# Make it PUBLIC so uploaded images can be served via getPublicUrl().
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
# Bucket name (must exist in your Supabase project)
SUPABASE_STORAGE_BUCKET="club-assets"

# =============================================================
# LOCAL SANDBOX FALLBACK (no Supabase available)
# =============================================================
# If NEXT_PUBLIC_SUPABASE_URL is unset, the app automatically falls back to:
#   - SQLite at file:/home/z/my-project/db/custom.db  (overridden by system env in sandbox)
#   - Local filesystem uploads at /public/uploads/*
#
# To run locally without Supabase, simply leave the Supabase vars blank
# and ensure your local Postgres (or SQLite) is reachable via DATABASE_URL.
